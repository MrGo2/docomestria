            {
              "row_id": "r18",
              "y_range": [602.646, 694.0],
              "cells": [
                {
                  "col": 0,
                  "text": "* 61 CUOTAS FIJAS DE 593,01 EUROS A SATISFACER MENSUALMENTE DESDE EL 31-05-2017 HASTA EL 31-05-2022 MAS UN PAGO A SATISFACER EL 30-04-2017 EN CONCEPTO DE INTERESES. SIN PERJUICIO DE LO ANTERIOR, EL BANCO APLICARÁ UNA BONIFICACIÓN A LOS CLIENTES QUE CUMPLAN LAS CONDICIONES PACTADOS CON UNA REDUCCIÓN DE 2,0000 PUNTOS PORCENTUALES DESDE LA PUESTA EN VIGOR DEL PRÉSTAMO HASTA EL DÍA 30-06-2017, AUNQUE EL CLIENTE NO CUMPLA LAS CONDICIONES ESTABLECIDAS PARA LA BONIFICACIÓN DE INTERESES DESCRITAS EN LA PÓLIZA. EN EL SUPUESTO QUE EL PRESTATARIO CUMPLIERA TODAS Y CADA UNA DE LAS CONDICIONES DE BONIFICACIÓN DE INTERESES DEL CONTRATO DURANTE EL PLAZO DE DURACIÓN DEL PRÉSTAMO, EL IMPORTE DE LAS CUOTAS CALCULADAS EN EL MOMENTO DE LA FORMALIZACIÓN PASARÍA A 541,53 EUROS.",
                  "role": "PROSE",
                  "bbox": {"x": 53.251, "y": 602.646, "w": 501.806, "h": 82.646},
                  "bold": true,
                  "case": "UPPER",
                  "docling_label": "footnote",
                  "compound_parts": null
                }
              ],
              "clarifiers": []
            }
          ]
        },
