              {"col": 0, "text": "Preciodelasamortizacionesanticipadas", "role": "LABEL", "bbox": {"x": 65.1, "y": 420.9, "w": 190.0, "h": 10.7}, "bold": false, "case": "lower", "docling_label": "text", "compound_parts": null},
